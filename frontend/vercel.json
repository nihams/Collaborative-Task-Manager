{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/frontend/browser",
  "rewrites": [
    { "source": "/auth/:path*", "destination": "https://collaborative-task-manager-l1k6.onrender.com/auth/:path*" },
    { "source": "/workspaces/mine", "destination": "https://collaborative-task-manager-l1k6.onrender.com/workspaces/mine" },
    { "source": "/workspaces/:id/boards", "destination": "https://collaborative-task-manager-l1k6.onrender.com/workspaces/:id/boards" },
    { "source": "/workspaces/:id/members", "destination": "https://collaborative-task-manager-l1k6.onrender.com/workspaces/:id/members" },
    { "source": "/workspaces/:id/members/:uid", "destination": "https://collaborative-task-manager-l1k6.onrender.com/workspaces/:id/members/:uid" },
    { "source": "/workspaces/:id/workload", "destination": "https://collaborative-task-manager-l1k6.onrender.com/workspaces/:id/workload" },
    { "source": "/workspaces/:id/audit-log", "destination": "https://collaborative-task-manager-l1k6.onrender.com/workspaces/:id/audit-log" },
    { "source": "/workspaces/:id", "destination": "https://collaborative-task-manager-l1k6.onrender.com/workspaces/:id" },
    { "source": "/workspaces", "destination": "https://collaborative-task-manager-l1k6.onrender.com/workspaces" },
    { "source": "/boards/:path*", "destination": "https://collaborative-task-manager-l1k6.onrender.com/boards/:path*" },
    { "source": "/boards", "destination": "https://collaborative-task-manager-l1k6.onrender.com/boards" },
    { "source": "/columns/:path*", "destination": "https://collaborative-task-manager-l1k6.onrender.com/columns/:path*" },
    { "source": "/tasks/assigned-to-me", "destination": "https://collaborative-task-manager-l1k6.onrender.com/tasks/assigned-to-me" },
    { "source": "/tasks/:path*", "destination": "https://collaborative-task-manager-l1k6.onrender.com/tasks/:path*" },
    { "source": "/tasks", "destination": "https://collaborative-task-manager-l1k6.onrender.com/tasks" },
    { "source": "/comments/:path*", "destination": "https://collaborative-task-manager-l1k6.onrender.com/comments/:path*" },
    { "source": "/notifications/unread-count", "destination": "https://collaborative-task-manager-l1k6.onrender.com/notifications/unread-count" },
    { "source": "/notifications/read-all", "destination": "https://collaborative-task-manager-l1k6.onrender.com/notifications/read-all" },
    { "source": "/notifications/:path*", "destination": "https://collaborative-task-manager-l1k6.onrender.com/notifications/:path*" },
    { "source": "/notifications", "destination": "https://collaborative-task-manager-l1k6.onrender.com/notifications" },
    { "source": "/audit-log/:path*", "destination": "https://collaborative-task-manager-l1k6.onrender.com/audit-log/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}