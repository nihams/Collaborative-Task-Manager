{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/frontend/browser",
  "rewrites": [
    { "source": "/auth/:path*",          "destination": "https://collaborative-task-manager-l1k6.onrender.com/auth/:path*" },
    { "source": "/workspaces",           "destination": "https://collaborative-task-manager-l1k6.onrender.com/workspaces" },
    { "source": "/workspaces/:path*",    "destination": "https://collaborative-task-manager-l1k6.onrender.com/workspaces/:path*" },
    { "source": "/boards/:path*",        "destination": "https://collaborative-task-manager-l1k6.onrender.com/boards/:path*" },
    { "source": "/boards",               "destination": "https://collaborative-task-manager-l1k6.onrender.com/boards" },
    { "source": "/columns/:path*",       "destination": "https://collaborative-task-manager-l1k6.onrender.com/columns/:path*" },
    { "source": "/tasks/:path*",         "destination": "https://collaborative-task-manager-l1k6.onrender.com/tasks/:path*" },
    { "source": "/tasks",                "destination": "https://collaborative-task-manager-l1k6.onrender.com/tasks" },
    { "source": "/comments/:path*",      "destination": "https://collaborative-task-manager-l1k6.onrender.com/comments/:path*" },
    { "source": "/notifications",        "destination": "https://collaborative-task-manager-l1k6.onrender.com/notifications" },
    { "source": "/notifications/:path*", "destination": "https://collaborative-task-manager-l1k6.onrender.com/notifications/:path*" },
    { "source": "/audit-log/:path*",     "destination": "https://collaborative-task-manager-l1k6.onrender.com/audit-log/:path*" },
    { "source": "/(.*)",                 "destination": "/index.html" }
  ]
}
